# ── Navegador (Vite) ──────────────────────────────────────────────
# Correo que se muestra si el envío falla.
VITE_CONTACT_EMAIL=sami@andesintelligence.com.pe
# Opcional: URL de la función de contacto si no está en /api/contact.
VITE_CONTACT_ENDPOINT=

# ── Servidor (función api/contact.js) — nunca uses el prefijo VITE_ aquí ──
# Private API key de Mailgun (Dashboard → API Keys).
MAILGUN_API_KEY=
# Dominio verificado en Mailgun, p. ej. mg.andesintelligence.com.pe
MAILGUN_DOMAIN=
# Si la cuenta de Mailgun es de la región UE: https://api.eu.mailgun.net
MAILGUN_API_BASE=https://api.mailgun.net
# Destinatarios separados por coma.
CONTACT_TO=sami@andesintelligence.com.pe,kevincarlosqa@gmail.com
# Remitente (debe ser del dominio de Mailgun). Por defecto: web@MAILGUN_DOMAIN
CONTACT_FROM=Web Andes Intelligence <web@mg.andesintelligence.com.pe>
# URL pública del sitio; de aquí se carga el logo del correo.
SITE_URL=https://andesintelligence.com.pe
